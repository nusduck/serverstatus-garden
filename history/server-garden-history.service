[Unit]
Description=Server Garden read-only history snapshot collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0027
ExecStart=/usr/bin/python3 /opt/server-garden-history/collector.py --source http://127.0.0.1:8080/json/stats.json --db /opt/server-garden-history/history.sqlite --output /opt/ServerStatus/web/assets/garden-history --once
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/server-garden-history /opt/ServerStatus/web/assets/garden-history
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
StandardOutput=journal
StandardError=journal
